`timescale 1 ns / 1ps
module xor_gate_tb;
reg a,b;
wire y;
// Instantiate the DUT
xor_gate uut(
.a(a),
.b(b),
.y(y)
);
initial begin 
$display("Time\tA\tB\tY");
$monitor("%0t\t%b\t%b\t%b",$time, a,b,y);
// TEST CASES
a=0; b=0; #10;
a=0; b=1; #10;
a=1; b=0; #10;
a=1; b=1; #10;
$finish;
end
endmodule


