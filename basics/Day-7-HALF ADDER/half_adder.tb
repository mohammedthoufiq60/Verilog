`timescale 1ns / 1ps
module half_adder_tb;
reg a,b;
wire sum,carry;
// Instatiate the DUT 
half_adder uut(
.a(a),
.b(b),
.sum(sum),
.carry(carry)
);
initial begin
$display("Time\tA\tB\tSUM\tCARRY");
$monitor("%0t\t%b\t%b\t%b\t%b", $time, a,b,sum,carry);
a=0; b=0; #10;
a=0; b=1; #10;
a=1; b=0; #10;
a=1; b=1; #10;
$finish;
end
endmodule